  "account": "madusarkar@gmail.com",
  "description": "Fine-tune Gmail labeling. Edit overrides and keywords, then run: ./gmail cleanup --dry-run",

  "labels": {
    "Priority/People": {
      "inbox": true,
      "description": "Real humans — never auto-archive"
    },
    "Priority/Action Required": {
      "inbox": true,
      "description": "Deadlines, confirmations, RSVPs, security alerts"
    },
    "Read/AI and Tech": {
      "inbox": true,
      "description": "AI newsletters and tools you want to read daily"
    },
    "Read/Newsletters": {
      "inbox": false,
      "description": "Other subscriptions worth keeping, lower priority"
    },
    "Transactions/Purchases": {
      "inbox": false,
      "description": "Orders, shipping, receipts"
    },
    "Transactions/Finance": {
      "inbox": false,
      "description": "Banks, bills, tax, payments"
    },
    "Work/Career": {
      "inbox": false,
      "description": "Job alerts, recruiters, applications"
    },
    "System/Notifications": {
      "inbox": false,
      "description": "GitHub, LinkedIn alerts, app notifications"
    },
    "System/Promotions": {
      "inbox": false,
      "description": "Marketing, sales, coupons"
    },
    "System/Processed": {
      "inbox": false,
      "internal": true,
      "description": "Agent audit trail — do not edit manually"
    }
  },

  "priority_order": [
    "ignore",
    "sender_exact",
    "sender_pattern",
    "domain",
    "subject_pattern",
    "people_heuristic",
