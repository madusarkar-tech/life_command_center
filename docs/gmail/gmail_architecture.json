    "sender_patterns": [
      {
        "match": "job*@linkedin.com",
        "label": "Work/Career",
        "note": "LinkedIn job alerts"
      },
      {
        "match": "*-noreply@linkedin.com",
        "label": "System/Notifications",
        "note": "LinkedIn system notifications"
      },
      {
        "match": "noreply@*",
        "label": null,
        "note": "Wildcard only — use senders/domains for specifics; null = skip pattern"
      }
    ],
    "subject_patterns": [
      {
        "match": "job alert",
        "label": "Work/Career",
        "case_insensitive": true
      },
      {
        "match": "application received",
        "label": "Work/Career",
        "case_insensitive": true
      },
      {
        "match": "security alert",
        "label": "Priority/Action Required",
        "case_insensitive": true
      },
      {
        "match": "verify your",
        "label": "Priority/Action Required",
        "case_insensitive": true
      },
      {
        "match": "order confirmation",
        "label": "Transactions/Purchases",
        "case_insensitive": true
      }
    ]
